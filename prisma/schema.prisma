generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String?                @unique
  password              String?
  phone                 String?                @unique
  role                  Role
  provider              AuthProvider           @default(LOCAL)
  googleId              String?                @unique
  avatar                String?
  isVerified            Boolean                @default(false)
  isActive              Boolean                @default(true)
  refreshToken          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  selfRegistered        Boolean                @default(true)
  clinic                Clinic?
  diagnosticCenterStaff DiagnosticCenterStaff?
  diagnosticCenter      DiagnosticCenter?
  doctor                Doctor?
  notifications         Notification[]
  patient               Patient?
  receptionist          Receptionist?

  @@map("users")
}

model Clinic {
  id                        String                    @id @default(uuid())
  userId                    String                    @unique
  clinicName                String
  phone                     String?
  whatsapp                  String?
  googleMapsUrl             String?
  address                   String?
  city                      String?
  state                     String?
  pincode                   String?
  isApproved                Boolean                   @default(false)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  latitude                  Float?
  longitude                 Float?
  logo                      String?
  onlineConsultationEnabled Boolean                   @default(true)
  
  // --- Notun add kora feature gulo ---
  isFeatured                Boolean                   @default(false)
  featuredOrder             Int                       @default(0)
  isAvailableToday          Boolean                   @default(true)
  // When ON, a patient with no visit in the last 1 month is auto-scheduled a
  // follow-up (and notified) by the daily follow-up job.
  autoFollowupEnabled       Boolean                   @default(false)
  // -----------------------------------

  announcements             Announcement[]
  appointments              Appointment[]
  holidays                  ClinicHoliday[]
  workingHours              ClinicWorkingHours[]
  user                      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorAssociations        DoctorClinicAssociation[]
  doctorLeaves              DoctorLeave[]
  doctors                   Doctor[]
  queues                    Queue[]
  receptionistDoctors       ReceptionistDoctor[]
  receptionists             Receptionist[]
  reviews                   Review[]
  referredTestRecommendations TestRecommendation[]      @relation("ReferringClinic")
  targetedTestRecommendations TestRecommendation[]      @relation("TargetClinic")
  testReferrals             TestReferral[]
  schedules                 DoctorSchedule[]
  followups                 Followup[]
  doctorDailyStatuses       DoctorDailyStatus[]

  @@index([isFeatured, featuredOrder]) // Data fast fetch korar jonno index
  @@map("clinics")
}

model Doctor {
  id                     String                    @id @default(uuid())
  userId                 String                    @unique
  // Optional: an Admin can onboard a doctor who is not yet attached to any clinic.
  // Clinic-scoped features (queues, reception booking) only apply once the doctor
  // is associated with a clinic via DoctorClinicAssociation.
  clinicId               String?
  specialization         String?
  qualification          String?
  experience             Int?
  fee                    Float?
  isVerified             Boolean                   @default(false)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  queueMode              QueueMode                 @default(LIVE)
  startTime              String?
  profilePhoto           String?
  avgConsultationMinutes Int?
  featuredOrder          Int                       @default(0)
  isFeatured             Boolean                   @default(false)
  
  isAvailable            Boolean                   @default(true)

  announcements          Announcement[]
  appointments           Appointment[]
  clinicAssociations     DoctorClinicAssociation[]
  leaves                 DoctorLeave[]
  clinic                 Clinic?                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  queues                 Queue[]
  assignedReceptionists  ReceptionistDoctor[]
  reviews                Review[]
  specializations        DoctorSpecialization[]
  schedules              DoctorSchedule[]
  followups              Followup[]
  dailyStatuses          DoctorDailyStatus[]

  @@index([isFeatured, featuredOrder])
  @@map("doctors")
}

model Receptionist {
  id              String               @id @default(uuid())
  userId          String               @unique
  clinicId        String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  assignedDoctors ReceptionistDoctor[]
  clinic          Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("receptionists")
}

model ReceptionistDoctor {
  id             String       @id @default(uuid())
  receptionistId String
  doctorId       String
  createdAt      DateTime     @default(now())
  clinicId       String
  clinic         Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor         Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  receptionist   Receptionist @relation(fields: [receptionistId], references: [id], onDelete: Cascade)

  @@unique([receptionistId, doctorId, clinicId])
  @@map("receptionist_doctors")
}

model Patient {
  id          String   @id @default(uuid())
  userId      String?  @unique
  name        String
  phone       String   @unique
  dob         DateTime?
  gender      String?
  bloodGroup  String?

  // Part 8: when a patient cancels an appointment while they had 3 active
  // advance appointments, new bookings are blocked until this timestamp.
  // Null/past = no restriction. Only ever set by the cancellation flow —
  // never touched by a normal cancellation that didn't hit the 3-active case.
  bookingRestrictedUntil DateTime?

  user        User?    @relation(fields: [userId], references: [id])
  appointments Appointment[]
  reviews              Review[]
  testRecommendations  TestRecommendation[]
  testReferrals        TestReferral[]
  followups            Followup[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@map("patients") // 🟢 FIXED: এটি দিলে Prisma আর টেবিল ডিলিট করবে না
}

model Queue {
  id              String         @id @default(uuid())
  doctorId        String
  date            DateTime       @db.Date
  currentToken    Int            @default(0)
  lastTokenIssued Int            @default(0)
  status          QueueStatus    @default(OPEN)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  clinicId        String
  scheduleId      String?        // NEW: Link to specific session

  appointments    Appointment[]
  logs            QueueLog[]
  clinic          Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor          Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  schedule        DoctorSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  // CHANGED: Added scheduleId so Morning and Evening sessions have separate queues
  @@unique([doctorId, clinicId, date, scheduleId])
  @@map("queues")
}

model QueueLog {
  id          String   @id @default(uuid())
  queueId     String
  action      String
  performedBy String
  meta        Json?
  createdAt   DateTime @default(now())
  queue       Queue    @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@map("queue_logs")
}

model Appointment {
  id                  String               @id @default(uuid())
  doctorId            String
  patientId           String
  queueId             String
  token               Int
  date                DateTime             @db.Date
  status              AppointmentStatus    @default(WAITING)
  bookingSource       BookingSource
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  isEmergency         Boolean              @default(false)
  clinicId            String
  cancelReason        String?
  cancelledBy         String?
  clinic              Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor              Doctor               @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  queue               Queue                @relation(fields: [queueId], references: [id], onDelete: Cascade)
  review              Review?
  testRecommendations TestRecommendation[]
  testReferrals       TestReferral[]
  followups           Followup[]

  @@unique([queueId, token])
  @@map("appointments")
}

model PlatformSetting {
  id                   String   @id @default(uuid())
  bookingWindowMinutes Int      @default(180)
  updatedAt            DateTime @updatedAt

  @@map("platform_settings")
}

model Announcement {
  id              String           @id @default(uuid())
  type            AnnouncementType
  title           String
  message         String
  clinicId        String?
  doctorId        String?
  createdByUserId String
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  clinic          Clinic?          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor          Doctor?          @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

model DoctorClinicAssociation {
  id          String        @id @default(uuid())
  doctorId    String
  clinicId    String
  fee         Float?
  queueMode   QueueMode     @default(LIVE)
  dayOfWeek   DayOfWeek
  startTime   String
  endTime     String
  status      RequestStatus @default(PENDING)
  requestedBy RequestedBy
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  clinic      Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor      Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_clinic_associations")
}

model ClinicWorkingHours {
  id                     String    @id @default(uuid())
  clinicId               String
  dayOfWeek              DayOfWeek
  openTime               String?
  closeTime              String?
  isClosed               Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  avgConsultationMinutes Int?
  clinic                 Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek])
  @@map("clinic_working_hours")
}

model ClinicHoliday {
  id        String   @id @default(uuid())
  clinicId  String
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@map("clinic_holidays")
}

model Review {
  id            String       @id @default(uuid())
  appointmentId String       @unique
  patientId     String
  doctorId      String
  clinicId      String
  rating        Int
  comment       String?
  status        ReviewStatus @default(PENDING)
  isReported    Boolean      @default(false)
  reportReason  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor        Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  isRead    Boolean          @default(false)
  meta      Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model DoctorLeave {
  id        String   @id @default(uuid())
  doctorId  String
  clinicId  String
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, clinicId, date])
  @@map("doctor_leaves")
}

model TestRecommendation {
  id                String       @id @default(uuid())
  patientId         String
  appointmentId     String?
  testName          String
  notes             String?
  referringClinicId String?
  targetClinicId    String?
  targetCenterName  String?
  createdByUserId   String
  createdByRole     Role
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  appointment       Appointment? @relation(fields: [appointmentId], references: [id])
  patient           Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  referringClinic   Clinic?      @relation("ReferringClinic", fields: [referringClinicId], references: [id])
  targetClinic      Clinic?      @relation("TargetClinic", fields: [targetClinicId], references: [id])

  @@map("test_recommendations")
}

model DiagnosticCenter {
  id                String                  @id @default(uuid())
  userId            String                  @unique
  centerName        String
  address           String?
  city              String?
  state             String?
  pincode           String?
  latitude          Float?
  longitude         Float?
  logo              String?
  isApproved        Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  
  // New fields
  phone             String?
  whatsapp          String?
  googleMapsUrl     String?

  // Relations
  staff             DiagnosticCenterStaff[]
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomingReferrals TestReferral[]
  availableTests    CenterTest[]            // <--- This is the missing line
  workingHours      DiagnosticCenterWorkingHours[]

  @@map("diagnostic_centers")
}

// This model was referenced by diagnosticCenter.repository.js's
// upsertWorkingHours() but was never actually defined here — calling that
// function would throw at runtime ("Cannot read properties of undefined
// (reading 'upsert')"). Mirrors ClinicWorkingHours exactly.
model DiagnosticCenterWorkingHours {
  id                 String          @id @default(uuid())
  diagnosticCenterId String
  dayOfWeek          DayOfWeek
  openTime           String?
  closeTime          String?
  isClosed           Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  diagnosticCenter   DiagnosticCenter @relation(fields: [diagnosticCenterId], references: [id], onDelete: Cascade)

  @@unique([diagnosticCenterId, dayOfWeek])
  @@map("diagnostic_center_working_hours")
}

model DiagnosticCenterStaff {
  id                 String           @id @default(uuid())
  userId             String           @unique
  diagnosticCenterId String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  diagnosticCenter   DiagnosticCenter @relation(fields: [diagnosticCenterId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("diagnostic_center_staff")
}

model TestReferral {
  id                 String             @id @default(uuid())
  patientId          String
  appointmentId      String?
  testNames          String[]
  notes              String?
  referringClinicId  String?
  diagnosticCenterId String
  createdByUserId    String
  createdByRole      Role
  // Diagnostic-side processing workflow (updated by the center or its staff)
  status             TestReferralStatus @default(PENDING)
  resultNotes        String?
  processedByUserId  String?
  completedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  appointment        Appointment?     @relation(fields: [appointmentId], references: [id])
  diagnosticCenter   DiagnosticCenter @relation(fields: [diagnosticCenterId], references: [id], onDelete: Cascade)
  patient            Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  referringClinic    Clinic?          @relation(fields: [referringClinicId], references: [id])

  @@map("test_referrals")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CLINIC
  RECEPTIONIST
  DOCTOR
  PATIENT
  DIAGNOSTIC_CENTER
  DIAGNOSTIC_STAFF
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum QueueMode {
  LIVE
  PRIVATE
  TIME_SLOT
}

enum QueueStatus {
  OPEN
  PAUSED
  CLOSED
}

enum AppointmentStatus {
  WAITING
  CHECKED_IN
  ABSENT
  COMPLETED
  CANCELLED
}

enum BookingSource {
  ONLINE
  RECEPTION
  WALK_IN
  PHONE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum RequestedBy {
  DOCTOR
  CLINIC
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AnnouncementType {
  DOCTOR_ABSENT
  CLINIC_CLOSED
  HOLIDAY
  EMERGENCY
  MAINTENANCE
  GENERAL
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  CLINIC_APPROVED
  CLINIC_REVOKED
  DOCTOR_VERIFIED
  CONNECTION_REQUEST_RECEIVED
  CONNECTION_REQUEST_RESPONDED
  GENERAL
}

enum RecurrenceType {
  DAILY
  WEEKLY
  MONTHLY_DATE
  MONTHLY_WEEKDAY
  SPECIFIC_DATE   
}

model SearchLocation {
  id        String   @id @default(uuid())
  nameEn    String   // English Name
  nameBn    String   // Bengali Name
  nameHi    String   // Hindi Name
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Specialization {
  id          String                 @id @default(uuid())
  name        String                 @unique
  iconUrl     String?
  description String?
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  doctors     DoctorSpecialization[]

  @@map("specializations")
}

model DoctorSpecialization {
  id               String         @id @default(uuid())
  doctorId         String
  specializationId String
  createdAt        DateTime       @default(now())
  doctor           Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@unique([doctorId, specializationId])
  @@map("doctor_specializations")
}

model DoctorSchedule {
  id                    String              @id @default(uuid())
  doctorId              String
  clinicId              String
  startTime             String
  endTime               String
  maxPatients           Int
  recurrenceType        RecurrenceType // DAILY, WEEKLY, MONTHLY_DATE, MONTHLY_WEEKDAY, SPECIFIC_DATE
  recurrencePattern     Json
  isActive              Boolean             @default(true)
  onlineBookingEnabled  Boolean             @default(true) // Clinic can turn off ONLINE booking for just this doctor/session — walk-in/reception still work
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  clinic                Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor                Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  queues                Queue[]
  exceptions            ScheduleException[]

  @@index([doctorId, clinicId])
  @@map("doctor_schedules")
}

// A one-off override/cancellation for a recurring schedule on a specific
// date (Step 13). If isCancelled, the schedule simply doesn't run that day.
// Otherwise, any non-null override* value replaces the schedule's normal
// value for that date only — the recurring schedule itself is untouched.
model ScheduleException {
  id                  String         @id @default(uuid())
  scheduleId          String
  date                DateTime       @db.Date
  isCancelled         Boolean        @default(false)
  overrideStartTime   String?
  overrideEndTime     String?
  overrideMaxPatients Int?
  reason              String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  schedule            DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, date])
  @@map("schedule_exceptions")
}

// General administrative audit trail (Step 53) — separate from QueueLog,
// which only covers queue-control actions. Fire-and-forget: a logging
// failure must never break the action it's describing.
model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  actorRole    Role?
  action       String
  targetType   String?
  targetId     String?
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorUserId])
  @@map("audit_logs")
}

model DiagnosticTest {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  centers     CenterTest[]

  @@map("diagnostic_tests")
}

model CenterTest {
  id                 String           @id @default(uuid())
  diagnosticCenterId String
  testId             String
  price              Float?
  isAvailable        Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  diagnosticCenter   DiagnosticCenter @relation(fields: [diagnosticCenterId], references: [id], onDelete: Cascade)
  test               DiagnosticTest   @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([diagnosticCenterId, testId])
  @@map("center_tests")
}

model OtpSession {
  id        String   @id @default(uuid())
  phone     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@map("otp_sessions")
}

// Follow-up: a doctor/clinic/receptionist schedules a future check-in date
// for a patient. On that date the patient gets a notification, and the
// clinic can see everyone they've scheduled a follow-up for.
model Followup {
  id              String         @id @default(uuid())
  patientId       String
  doctorId        String
  clinicId        String
  appointmentId   String? // the visit this follow-up was scheduled from, if any
  followUpDate    DateTime       @db.Date
  notes           String?
  status          FollowupStatus @default(SCHEDULED)
  reminderSentAt  DateTime?
  createdByUserId String
  createdByRole   Role
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic          Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id])

  @@index([doctorId, clinicId, followUpDate])
  @@index([patientId])
  @@map("followups")
}

enum FollowupStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TestReferralStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Persistent per-day operational status for a doctor at a clinic (Step 40) —
// separate from the one-shot delay notification, so Live Doctor cards can
// show "Running Late" as actual state, not just something that was announced
// once and then forgotten.
model DoctorDailyStatus {
  id           String                  @id @default(uuid())
  doctorId     String
  clinicId     String
  date         DateTime                @db.Date
  status       DoctorOperationalStatus @default(NORMAL)
  delayMinutes Int?
  updatedAt    DateTime                @updatedAt
  doctor       Doctor                  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic       Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([doctorId, clinicId, date])
  @@map("doctor_daily_status")
}

enum DoctorOperationalStatus {
  NORMAL
  RUNNING_LATE
  PAUSED
}